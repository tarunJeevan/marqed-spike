{
  "model": "claude-sonnet-5-5",
  "effortLevel": "high",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(/docs/CONTRACTS.md)",
      "Edit(/docs/SPIKE_GOAL.md)",
      "Edit(/docs/tasks/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
    ],
    "ask": [
      "Bash(cargo install *)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo publish *)",
      "Bash(rm *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git -C rev-parse *)",
      "Bash(git -C merge-base *)",
      "Bash(git -C worktree *)",
      "Bash(git -C branch *)",
      "Bash(git -C add *)",
      "Bash(git -C commit *)",
      "Bash(git -C push *)",
      "Bash(git -C reset *)",
      "Bash(git -C checkout *)",
      "Bash(git -C switch *)",
      "Bash(git -C restore *)",
      "Bash(git -C stash *)",
      "Bash(git -C clean *)",
      "Bash(git -C merge *)",
      "Bash(git -C rebase *)",
      "Bash(git -C cherry-pick *)",
      "Bash(git -C rm *)",
      "Bash(git -C mv *)"
    ],
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo fix *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "WebFetch(domain:docs.rs)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
    ]
  }
}
